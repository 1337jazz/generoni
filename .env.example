# Listen address. Format host:port. Empty host = all interfaces
ADDR=:8080

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Max time to read request headers
READ_HEADER_TIMEOUT=5s

# Max time to read the whole request, including body
READ_TIMEOUT=15s

# Max time to write the response
WRITE_TIMEOUT=15s

# Max time a handler may run per request
REQUEST_TIMEOUT=10s

# Max time an idle keep-alive connection stays open
IDLE_TIMEOUT=60s

# Max time to wait for in-flight requests on shutdown
SHUTDOWN_TIMEOUT=10s

# Max size of request headers, in bytes
MAX_HEADER_BYTES=1048576

# Max requests per client per rate limit window
RATE_LIMIT=100

# Length of the rate limit window
RATE_LIMIT_WINDOW=1m

# Path to the SQLite database file. In Docker use an absolute path on a mounted volume, e.g. /data/app.db
DATABASE_PATH=data/app.db
